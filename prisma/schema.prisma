generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  inactive
}

enum WorkflowStatus {
  draft
  published
  archived
}

enum ExecutionStatus {
  pending
  running
  completed
  failed
}

enum PaymentType {
  stripe
  sepay
  momo
}

enum Currency {
  USD
  VND
}

model User {
  id         String     @id @default(uuid())
  name       String
  email      String     @unique
  password   String?
  image      String?
  status     UserStatus @default(active)
  credits    Int        @default(0)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  accounts            Account[]
  workflows           Workflow[]
  workflowExecutions  WorkflowExecution[]
  executionPhases     WorkflowExecutionPhase[]
  billings            Billing[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Workflow {
  id              String         @id @default(uuid())
  userId          String
  name            String
  description     String         @default("")
  definition      String         @default("")
  executionPlan   String         @default("")
  cron            String         @default("")
  status          WorkflowStatus @default(draft)
  creditsCost     Int            @default(0)
  lastRunAt       DateTime?
  lastRunId       String?
  lastRunStatus   String         @default("")
  nextRunAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions WorkflowExecution[]
}

model WorkflowExecution {
  id               String          @id @default(uuid())
  workflowId       String
  userId           String
  trigger          String
  status           ExecutionStatus @default(running)
  creditsConsumed  Int             @default(0)
  createdAt        DateTime        @default(now())
  startedAt        DateTime?
  completedAt      DateTime?

  workflow  Workflow                 @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  phases    WorkflowExecutionPhase[]
}

model WorkflowExecutionPhase {
  id                  String          @id @default(uuid())
  workflowExecutionId String
  userId              String
  status              ExecutionStatus @default(running)
  number              Int
  node                String
  name                String
  inputs              String          @default("")
  outputs             String          @default("")
  creditsConsumed     Int             @default(0)
  startedAt           DateTime?
  completedAt         DateTime?

  workflowExecution WorkflowExecution @relation(fields: [workflowExecutionId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs              ExecutionLog[]
}

enum LogLevel {
  info
  warning
  error
  debug
}

model ExecutionLog {
  id               String   @id @default(uuid())
  executionPhaseId String
  logLevel         LogLevel
  message          String
  timestamp        DateTime @default(now())

  executionPhase WorkflowExecutionPhase @relation(fields: [executionPhaseId], references: [id], onDelete: Cascade)
}

model Billing {
  id          String      @id @default(uuid())
  userId      String
  paymentId   String
  paymentType PaymentType
  description String      @default("")
  amount      Float
  currency    Currency    @default(USD)
  date        DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
